# Vercel-only deployment reference. Copy frontend/.env.example to
# frontend/.env.local for the Next.js app, and backend/.env.example to
# backend/.env for local API development. In Vercel, add these variables to
# their respective frontend and backend projects.

# Frontend project
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend project
APP_NAME=Jal Jeevan Swasthya
APP_VERSION=1.0.0
DEBUG=true
DATABASE_URL=sqlite:///./healthwatch.db
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","https://your-frontend-project.vercel.app"]
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
REDIS_URL=
REDIS_RETRY_SECONDS=30
CACHE_ENABLED=true
CACHE_TTL=300
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
TRUST_PROXY_HEADERS=true
ML_PRETRAIN_ENABLED=false
RESET_DATABASE=false
