# Copy to backend/.env for local development. Never commit backend/.env.

# Application
APP_NAME=Jal Jeevan Swasthya
APP_VERSION=1.0.0
DEBUG=true
# Set DEBUG=false in the Vercel backend project.
# Database. Use a pooled managed PostgreSQL URL on Vercel. Plain
# postgresql:// URLs are accepted and normalized to psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/healthwatch
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Authentication. Generate a private value with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# Browser origins must be a JSON array, or * for a public credential-free API.
CORS_ORIGINS=["http://localhost:3000","https://your-frontend-project.vercel.app"]

# Set a managed rediss:// URL in Vercel, or leave empty for process-local fallback.
REDIS_URL=
REDIS_RETRY_SECONDS=30
CACHE_ENABLED=true
CACHE_TTL=300

# Request protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
# Vercel supplies trusted forwarding headers to the function.
TRUST_PROXY_HEADERS=true

# Model training is normally run explicitly with: python -m app.ml.train
ML_PRETRAIN_ENABLED=false

# Development seeding. Never set this to true in Vercel.
RESET_DATABASE=false
