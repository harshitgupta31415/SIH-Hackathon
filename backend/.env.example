# Copy to backend/.env for local development. Do not commit the copied file.
FASTAPI_APP=app.main:app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthwatch
REDIS_URL=redis://localhost:6379/0
# Generate a private value with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
